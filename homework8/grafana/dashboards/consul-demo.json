{
  "title": "Consul Cluster — Demo Dashboard",
  "uid": "consul-demo-main",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["consul", "demo"],
  "panels": [

    {
      "id": 1,
      "title": "Total Nodes",
      "description": "consul_state_nodes — total nodes registered in the datacenter (servers + clients)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 5 },
            { "color": "green", "value": 7 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_state_nodes{datacenter=\"dc1\"}",
        "legendFormat": "nodes"
      }]
    },

    {
      "id": 2,
      "title": "Servers",
      "description": "consul_consul_members_servers — consul server agents in dc1",
      "type": "stat",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 2 },
            { "color": "green", "value": 3 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_members_servers{datacenter=\"dc1\"}",
        "legendFormat": "servers"
      }]
    },

    {
      "id": 3,
      "title": "Clients",
      "description": "consul_members_clients — consul client agents in dc1",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 3 },
            { "color": "green", "value": 4 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_members_clients{datacenter=\"dc1\"}",
        "legendFormat": "clients"
      }]
    },

    {
      "id": 4,
      "title": "Is Leader",
      "description": "consul_server_isLeader — 1 if this agent is the current Raft leader",
      "type": "stat",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Follower", "color": "blue" },
            "1": { "text": "LEADER ⭐", "color": "green" }
          }}],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_server_isLeader{job=\"consul_servers\"}",
        "legendFormat": "{{instance}}"
      }]
    },

    {
      "id": 5,
      "title": "Service Instances",
      "description": "consul_state_service_instances — total running service instances (nginx × 3 + consul × 3)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 4 },
            { "color": "green", "value": 6 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_state_service_instances{datacenter=\"dc1\"}",
        "legendFormat": "instances"
      }]
    },

    {
      "id": 6,
      "title": "KV Entries",
      "description": "consul_state_kv_entries — number of keys in the KV store. Changes when you run consul kv put.",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "purple", "value": 0 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_state_kv_entries{datacenter=\"dc1\"}",
        "legendFormat": "kv entries"
      }]
    },

    {
      "id": 7,
      "title": "Autopilot Healthy",
      "description": "consul_autopilot_healthy — 1=cluster healthy. Failure tolerance shows how many servers can fail.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "UNHEALTHY ❌", "color": "red" },
            "1": { "text": "Healthy ✅", "color": "green" }
          }}],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_autopilot_healthy",
        "legendFormat": "healthy"
      }]
    },

    {
      "id": 8,
      "title": "Failure Tolerance",
      "description": "consul_autopilot_failure_tolerance — how many servers can fail before quorum is lost. With 3 servers = 1.",
      "type": "stat",
      "gridPos": { "x": 21, "y": 0, "w": 3, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 1 },
            { "color": "green", "value": 2 }
          ]}
        }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_autopilot_failure_tolerance",
        "legendFormat": "can lose"
      }]
    },

    {
      "id": 9,
      "title": "Cluster State — Nodes / Servers / Clients / Services over time",
      "description": "Kill a server with 'docker stop consul-server-3' and watch Nodes drop. Start it back and it recovers.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_state_nodes{datacenter=\"dc1\"}", "legendFormat": "Nodes total" },
        { "datasource": "Prometheus", "expr": "consul_members_servers{datacenter=\"dc1\"}", "legendFormat": "Servers" },
        { "datasource": "Prometheus", "expr": "consul_members_clients{datacenter=\"dc1\"}", "legendFormat": "Clients" },
        { "datasource": "Prometheus", "expr": "consul_state_service_instances{datacenter=\"dc1\"}", "legendFormat": "Service instances" }
      ]
    },

    {
      "id": 10,
      "title": "Memberlist — LAN alive nodes",
      "description": "consul_memberlist_node_instances — alive members on the LAN gossip ring. Should match total nodes.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_memberlist_node_instances{network=\"lan\",node_state=\"alive\"}", "legendFormat": "LAN alive" },
        { "datasource": "Prometheus", "expr": "consul_memberlist_node_instances{network=\"wan\",node_state=\"alive\"}", "legendFormat": "WAN alive" }
      ]
    },

    {
      "id": 11,
      "title": "Raft Commit Time (ms) — p50 / p99",
      "description": "consul_raft_commitTime — time to commit a log entry. Spikes when leader election happens. Kill consul-server-1 to trigger one.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 100 }
          ]}
        }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_raft_commitTime{quantile=\"0.5\",job=\"consul_servers\"}", "legendFormat": "{{instance}} p50 ms" },
        { "datasource": "Prometheus", "expr": "consul_raft_commitTime{quantile=\"0.99\",job=\"consul_servers\"}", "legendFormat": "{{instance}} p99 ms" }
      ]
    },

    {
      "id": 12,
      "title": "Raft Leader Last Contact (ms) — p50 / p99",
      "description": "consul_raft_leader_lastContact — how long since leader contacted followers. High = network stress. Values: p50~35ms, p99~90ms is normal.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 200 },
            { "color": "red", "value": 500 }
          ]}
        }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_raft_leader_lastContact{quantile=\"0.5\",job=\"consul_servers\"}", "legendFormat": "{{instance}} p50 ms" },
        { "datasource": "Prometheus", "expr": "consul_raft_leader_lastContact{quantile=\"0.99\",job=\"consul_servers\"}", "legendFormat": "{{instance}} p99 ms" }
      ]
    },

    {
      "id": 13,
      "title": "Raft Replication — Heartbeats/s per Peer",
      "description": "consul_raft_replication_heartbeat — leader sends heartbeats to each follower ~every 100ms. Each peer_id is a follower server.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(consul_raft_replication_heartbeat_count{job=\"consul_servers\"}[30s])",
        "legendFormat": "peer {{peer_id}}"
      }]
    },

    {
      "id": 14,
      "title": "Raft Replication — AppendEntries RPC latency (ms)",
      "description": "consul_raft_replication_appendEntries_rpc — time to replicate log entries to each follower. Baseline ~0.35ms p50.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_raft_replication_appendEntries_rpc{quantile=\"0.5\",job=\"consul_servers\"}", "legendFormat": "{{peer_id}} p50" },
        { "datasource": "Prometheus", "expr": "consul_raft_replication_appendEntries_rpc{quantile=\"0.99\",job=\"consul_servers\"}", "legendFormat": "{{peer_id}} p99" }
      ]
    },

    {
      "id": 15,
      "title": "Gossip — LAN & WAN messages/s",
      "description": "consul_memberlist_gossip — gossip protocol traffic between nodes. This is how Consul detects failures. LAN = within DC, WAN = across DCs.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(consul_memberlist_gossip_count{network=\"lan\"}[30s])", "legendFormat": "LAN gossip/s" },
        { "datasource": "Prometheus", "expr": "rate(consul_memberlist_gossip_count{network=\"wan\"}[30s])", "legendFormat": "WAN gossip/s" }
      ]
    },

    {
      "id": 16,
      "title": "Gossip — Probe Node latency (ms)",
      "description": "consul_memberlist_probeNode — time to probe another node for health. If this goes above ~1s Consul marks the node suspect.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 1000 }
          ]}
        }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_memberlist_probeNode{network=\"lan\",quantile=\"0.5\"}", "legendFormat": "LAN p50 ms" },
        { "datasource": "Prometheus", "expr": "consul_memberlist_probeNode{network=\"lan\",quantile=\"0.99\"}", "legendFormat": "LAN p99 ms" }
      ]
    },

    {
      "id": 17,
      "title": "KV Store — Writes/s",
      "description": "consul_kvs_apply_count — rate of KV write operations. Run: for i in $(seq 1 20); do consul kv put demo/$i val; done — watch spikes.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(consul_kvs_apply_count[30s])",
        "legendFormat": "KV writes/s"
      }]
    },

    {
      "id": 18,
      "title": "RPC — Requests/s & Blocking Queries",
      "description": "consul_rpc_request = total RPC calls. consul_rpc_queries_blocking = long-poll watchers (consul-template uses these).",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(consul_rpc_query[30s])", "legendFormat": "RPC queries/s" },
        { "datasource": "Prometheus", "expr": "consul_rpc_queries_blocking", "legendFormat": "Blocking queries (watchers)" },
        { "datasource": "Prometheus", "expr": "rate(consul_client_rpc[30s])", "legendFormat": "Client RPC/s" }
      ]
    },

    {
      "id": 19,
      "title": "API HTTP Latency (ms) — agent metrics & leader endpoints",
      "description": "consul_api_http — latency of the HTTP API. These are the two endpoints Prometheus scrapes.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "consul_api_http{quantile=\"0.5\"}", "legendFormat": "{{path}} p50" },
        { "datasource": "Prometheus", "expr": "consul_api_http{quantile=\"0.99\"}", "legendFormat": "{{path}} p99" }
      ]
    },

    {
      "id": 20,
      "title": "FSM Apply — State Machine ops/s",
      "description": "consul_raft_fsm_apply — Raft Finite State Machine applies. Every KV write, service registration, and catalog change shows up here.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(consul_raft_fsm_apply_count[30s])", "legendFormat": "FSM apply/s" },
        { "datasource": "Prometheus", "expr": "rate(consul_fsm_register_count[30s])", "legendFormat": "FSM register/s" },
        { "datasource": "Prometheus", "expr": "rate(consul_fsm_deregister_count[30s])", "legendFormat": "FSM deregister/s" }
      ]
    },

    {
      "id": 21,
      "title": "Goroutines",
      "description": "consul_runtime_num_goroutines — Go runtime goroutines. Stable ~280. Spikes under load.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 52, "w": 8, "h": 7 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_runtime_num_goroutines",
        "legendFormat": "goroutines"
      }]
    },

    {
      "id": 22,
      "title": "Heap Memory (MB)",
      "description": "consul_runtime_alloc_bytes — Go heap currently allocated. ~27MB is normal for this demo.",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 52, "w": 8, "h": 7 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_runtime_alloc_bytes / 1024 / 1024",
        "legendFormat": "heap alloc MB"
      }]
    },

    {
      "id": 23,
      "title": "GC Pause (ms)",
      "description": "consul_runtime_gc_pause_ns — Go garbage collector pause time. Should be under 1ms.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 52, "w": 8, "h": 7 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "consul_runtime_gc_pause_ns{quantile=\"0.99\"} / 1000000",
        "legendFormat": "GC pause p99 ms"
      }]
    }

  ]
}