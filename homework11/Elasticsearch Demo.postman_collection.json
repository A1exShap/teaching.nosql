    {
      "name": "2. Create Index Template",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"index_patterns\": [\"text-*\"],\n  \"settings\": {\n    \"number_of_shards\": 1,\n    \"number_of_replicas\": 0\n  },\n  \"mappings\": {\n    \"properties\": {\n      \"text\": {\n        \"type\": \"text\",\n        \"analyzer\": \"russian\"\n      }\n    }\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:9200/_template/text-template",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "9200",
          "path": [
            "_template",
            "text-template"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Create Index",
      "request": {
        "method": "PUT",
        "header": [],
